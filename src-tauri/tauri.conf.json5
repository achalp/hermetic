// Tauri v2 config for the Hermetic desktop shell.
//
// This is `tauri.conf.json5` (not `.json`) ON PURPOSE: Tauri parses config with
// deny-unknown-fields, so a plain-JSON `"//comment"` key fails the build. JSON5
// (natively supported by Tauri) lets the §7 security decisions carry real inline
// comments — see specs/pyodide-wasm-sandbox-2026-08-26.md §4a + §7.
{
  $schema: "https://schema.tauri.app/config/2",
  productName: "Hermetic",
  version: "0.5.0-rc.1",
  identifier: "com.hermetic.desktop",

  build: {
    // `tauri dev`: start the Next dev server; the window loads it (src/lib.rs dev
    // branch). `tauri build`: assemble the sidecar (Next standalone + node + assets)
    // BEFORE bundling, so `resources.sidecar` exists. Run from the project root.
    beforeDevCommand: "pnpm dev",
    beforeBuildCommand: "pnpm desktop:sidecar",
    devUrl: "http://localhost:3000",

    // The REAL frontend is the server-rendered Next app served by the sidecar (the
    // app is NOT output:'export'-able — §4a). This placeholder dir only satisfies the
    // config schema / bundler; the window never loads it (src/lib.rs points at the
    // sidecar's loopback origin in release, or devUrl in dev).
    frontendDist: "../dist-placeholder",
  },

  app: {
    // §7 #1: no window.__TAURI__ injected into the page — removes an ambient
    // host-reachable global from untrusted webview JS.
    withGlobalTauri: false,

    // NO static windows: the main window is created in src/lib.rs::run() AFTER the
    // Node sidecar is ready, pointed at its loopback origin (build log D15). A
    // config window would load the frontendDist placeholder first and flash.
    windows: [],

    security: {
      // The APP-document CSP (reasonably tight).
      //
      // NOTE: the untrusted EXECUTION WORKER does NOT use this — it carries its
      // OWN stricter blob-document CSP written at RUNTIME (§7 #2):
      //   default-src 'none'; script-src blob: 'wasm-unsafe-eval';
      //   connect-src 'none'; img-src 'none'; worker-src 'none'; child-src 'none'
      // That worker CSP is THE load-bearing network control and is intentionally
      // NOT expressed here. `script-src` there must NOT include 'self' (the
      // Phase 0(b) escape suite proved 'self' permits importScripts()/import()
      // exfil). The packaged-build app CSP below is further tightened (§7 #5b:
      // drop huggingface.co, constrain connect-src/img-src) once the sidecar
      // origin is known.
      // MAP BASEMAP (build log D23): MapLibre fetches its style JSON and raster
      // tiles from CARTO, so `basemaps.cartocdn.com` is allowed on connect-src (the
      // style + vector fetches) and img-src (the raster tiles). Without BOTH, pins
      // render but the map is a blank box — the tiles are the only part that needs
      // the network.
      //
      // PRIVACY NOTE, stated plainly: tiles are requested per VIEWPORT, so CARTO
      // learns which patch of earth a user is looking at (not their data, but a
      // strong hint about its subject). That is a real qualification of the app's
      // "your data stays local" promise and is an accepted, deliberate trade for a
      // usable map — NOT an oversight. Nothing else here is widened: no scripts, no
      // other hosts, and analysis egress still goes only through the Rust core.
      csp: "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.basemaps.cartocdn.com https://basemaps.cartocdn.com; connect-src 'self' http://localhost:3000 ws://localhost:3000 https://*.basemaps.cartocdn.com https://basemaps.cartocdn.com; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      // Capability grants live in capabilities/default.json — MINIMAL by design
      // (§7 #1): NO fs/shell/http/dialog/os permissions.
    },
  },

  bundle: {
    active: true,
    targets: "all",
    // Placeholder icons (generated). `cargo build` does not consume these;
    // `tauri build` bundling does. Replace before Phase 3 productionization.
    icon: ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],

    // The assembled Node sidecar (build log D15) — the Next standalone server + the
    // Node runtime + pyodide dist + egress-fetch bin + the docker/sandbox runtime
    // package. Built by `scripts/build-desktop-sidecar.mjs` BEFORE `tauri build`
    // (see beforeBuildCommand). Copied into the app's resource dir; src/lib.rs spawns
    // `<resources>/sidecar/node server.js`. `cargo check` does not validate that the
    // dir exists (bundling does), so the shell still compiles pre-build.
    resources: { sidecar: "sidecar" },

    // Emit the signed update artifacts (.sig files) alongside the bundles. The
    // signing key is supplied by CI via TAURI_SIGNING_PRIVATE_KEY{,_PASSWORD};
    // a LOCAL build without those env vars simply skips signing, so
    // `pnpm desktop:build` keeps working on a dev machine with no key.
    createUpdaterArtifacts: true,

    macOS: {
      // No Developer ID yet — publishing OS-unsigned for now is a DELIBERATE
      // call (2026-09; the updater chain stays minisign-signed regardless).
      // "-" ad-hoc signs the whole .app so it at least launches on Apple
      // Silicon (arm64 refuses fully unsigned binaries); Gatekeeper still
      // warns on first open of a downloaded copy (right-click → Open, or
      // System Settings → Privacy & Security → Open Anyway). Replace with the
      // real identity when Developer ID + notarization secrets land.
      signingIdentity: "-",
    },
  },

  plugins: {
    // Auto-update (tag-driven releases publish latest.json + signed bundles).
    //
    // TRUST: `pubkey` is the minisign PUBLIC half of the release keypair
    // (id 413EA66010356217). Tauri verifies every downloaded bundle against it
    // BEFORE installing, so a compromised CDN/release asset cannot ship code —
    // the private key never leaves the maintainer's keychain + CI secret.
    //
    // The endpoint is the GitHub "latest" release, which by definition EXCLUDES
    // prereleases — so an `-rc` tag can exercise the whole pipeline without any
    // installed app pulling it.
    updater: {
      pubkey: "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQxM0VBNjYwMTAzNTYyMTcKUldRWFlqVVFZS1krUVJVYkhLQmZFRkFUeTRDVmd0TUtvRFR3TVY4b2RHcGZMQ1g5aVA4a3o1VzQK",
      endpoints: ["https://github.com/achalp/hermetic/releases/latest/download/latest.json"],
      windows: { installMode: "passive" },
    },
  },
}
