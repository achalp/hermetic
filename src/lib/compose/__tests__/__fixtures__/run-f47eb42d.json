    "plan": {
      "nodes": [
        {
          "id": "pn_msr2mt80_c",
          "op": "ANSWER",
          "refs": ["top_spend_category", "category_spend_share"],
          "text": "Spend this period concentrated most heavily in $finding:top_spend_category.period, which accounted for $finding:top_spend_category.value of total spend \u2014 a $finding:category_spend_share.shares_pct share of the statement."
        },
        {
          "id": "pn_msr2mt80_d",
          "op": "EXPLAIN",
          "refs": ["category_spend_share"],
          "text": "Across all categories, spend shares sum to $finding:category_spend_share.sums_to_100 of the statement, leaving a residual of $finding:category_spend_share.residual_pct unattributed to any single category.",
          "anchor": "chart_category_spend"
        },
        {
          "id": "pn_msr2mt80_e",
          "op": "CAVEAT",
          "refs": ["amount_sign_convention"],
          "anchor": "chart_category_spend"
        },
        {
          "id": "pn_msr2mt80_f",
          "op": "EXPLAIN",
          "refs": ["daily_spend_trend"],
          "text": "Daily spend moved in a $finding:daily_spend_trend.direction direction over the period, with a slope of $finding:daily_spend_trend.slope_per_period per day and a confidence interval of $finding:daily_spend_trend.slope_ci95, at a p-value of $finding:daily_spend_trend.p_value.",
          "anchor": "chart_daily_spend"
        },
        {
          "id": "pn_msr2mt80_g",
          "op": "NOTE",
          "refs": ["daily_spend_step_change"],
          "text": "No persistent step change in daily spend survived the detection gates \u2014 the trend line above is the more reliable read on movement across the period."
        },
        {
          "id": "pn_msr2mt80_h",
          "op": "EXPLAIN",
          "refs": ["peak_spend_day"],
          "text": "The single heaviest day of spend was $finding:peak_spend_day.period, totaling $finding:peak_spend_day.value across $finding:peak_spend_day.n transactions.",
          "anchor": "chart_daily_spend"
        },
        {
          "id": "pn_msr2mt80_i",
          "op": "CALLOUT",
          "refs": ["category_spend_heterogeneity"],
          "text": "Individual transaction amounts differ meaningfully by category ($finding:category_spend_heterogeneity.test, p-value $finding:category_spend_heterogeneity.p_value), confirming categories aren't just splitting similar-sized purchases but drawing from genuinely different spend levels."
        },
        {
          "id": "pn_msr2mt80_j",
          "op": "EXPLAIN",
          "refs": ["spend_amount_distribution"],
          "text": "The typical spend transaction sat near $finding:spend_amount_distribution.median, with a mean of $finding:spend_amount_distribution.mean pulled by a skew of $finding:spend_amount_distribution.skew; the middle half of transactions ranged between $finding:spend_amount_distribution.p25 and $finding:spend_amount_distribution.p75, while the extremes stretched from $finding:spend_amount_distribution.min to $finding:spend_amount_distribution.max.",
          "anchor": "chart_weekday_spend"
        },
        {
          "id": "pn_msr2mt80_k",
          "op": "INSIGHT",
          "refs": [
            "top_spend_category",
            "category_spend_heterogeneity",
            "spend_amount_distribution"
          ],
          "text": "The dominance of $finding:top_spend_category.period is consistent with the statistically confirmed spread across categories: this isn't a month of uniform small purchases inflated by volume, but one shaped by a handful of larger, category-specific outlays sitting well above the median of $finding:spend_amount_distribution.median."
        },
        {
          "id": "pn_msr2mt80_l",
          "op": "METHOD",
          "refs": ["category_spend_share", "daily_spend_trend", "category_spend_heterogeneity"],
          "text": "Category shares were computed from attestation-weighted spend totals, the daily trend from a count-weighted OLS fit, and category differences tested via $finding:category_spend_heterogeneity.test."
        },
        {
          "id": "pn_msr2mt80_m",
          "op": "CONCLUSION",
          "refs": ["top_spend_category", "daily_spend_trend"],
          "text": "The month was defined by concentrated spend in $finding:top_spend_category.period and a $finding:daily_spend_trend.direction daily trend, with meaningful variation in transaction size across categories rather than a single uniform spending pattern."
        }
      ]
    },
