{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    // Static-analysis L1 (verified 0 errors before adoption): a switch case
    // falling through silently and a code path returning undefined implicitly
    // are now compile errors forever, not advisory checks. The heavier flags
    // (noUncheckedIndexedAccess: 1155 hits, exactOptionalPropertyTypes: 423)
    // were sampled in security-critical files — all in-range-by-construction —
    // and stay unadopted; enabling them wholesale would bury real signal.
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", ".next", "src-tauri/sidecar", "src-tauri/target"]
}
