# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
package-lock.json
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# runtime logs (accidentally committed before; never track)
*.log

# env files
.env*
!.env.example
.bigquery-credentials.json
.warehouse-connections.json

# runtime config & user data: ignore everything under data/ EXCEPT test
# fixtures, which need to be tracked so CI can run fixture-dependent tests.
data/*
!data/test-fixtures/
!data/test-fixtures/**

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
