{
  "name": "hermetic",
  "version": "0.3.0-rc.1",
  "description": "Upload CSV/Excel files, ask questions in natural language, get interactive dashboards powered by Claude",
  "license": "MIT",
  "author": "Hermetic Contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/achalp/hermetic.git"
  },
  "keywords": [
    "csv",
    "data-visualization",
    "dashboard",
    "claude",
    "llm",
    "generative-ui",
    "next.js"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--import ./scripts/server-timeouts.mjs' next dev -H ${HERMETIC_HOST:-127.0.0.1}",
    "build": "next build",
    "build:duckdb-wasm": "node scripts/build-duckdb-wasm-assets.mjs",
    "start": "NODE_OPTIONS='--import ./scripts/server-timeouts.mjs' next start -H ${HERMETIC_HOST:-127.0.0.1}",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "ratchet": "node scripts/ratchet.mjs",
    "isolation": "node scripts/isolation-check.mjs",
    "golden:record": "node scripts/golden/run-journeys.mjs record",
    "golden:check": "node scripts/golden/run-journeys.mjs check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "analyze": "ANALYZE=true next build",
    "prepare": "husky",
    "cli": "tsx src/cli/main.ts",
    "mcp": "tsx src/mcp/main.ts",
    "mcp:build-viewer": "node scripts/build-mcp-viewer.mjs",
    "mcpb:build": "node scripts/build-mcp-viewer.mjs && node scripts/build-mcpb.mjs",
    "mcpb:smoke": "node scripts/mcpb-smoke.mjs",
    "test:e2e": "tsx scripts/e2e-build-fixture.mts && playwright test",
    "desktop:sidecar": "node scripts/build-desktop-sidecar.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "node scripts/build-desktop.mjs",
    "tauri": "tauri"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.69",
    "@ai-sdk/anthropic": "^3.0.46",
    "@ai-sdk/google-vertex": "^5.0.61",
    "@ai-sdk/openai": "^3.0.37",
    "@aws-crypto/sha256-js": "5.2.0",
    "@clickhouse/client": "^1.23.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@databricks/sql": "^2.0.0",
    "@deck.gl/aggregation-layers": "^9.2.9",
    "@deck.gl/core": "^9.2.9",
    "@deck.gl/geo-layers": "^9.2.9",
    "@deck.gl/layers": "^9.2.9",
    "@deck.gl/react": "^9.2.9",
    "@e2b/code-interpreter": "^2.3.3",
    "@google-cloud/bigquery": "^9.0.2",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/keyring": "^1.3.0",
    "@nivo/bar": "^0.99.0",
    "@nivo/bump": "^0.99.0",
    "@nivo/calendar": "^0.99.0",
    "@nivo/chord": "^0.99.0",
    "@nivo/core": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@nivo/marimekko": "^0.99.0",
    "@nivo/pie": "^0.99.0",
    "@nivo/radar": "^0.99.0",
    "@nivo/sankey": "^0.99.0",
    "@nivo/scatterplot": "^0.99.0",
    "@nivo/stream": "^0.99.0",
    "@nivo/sunburst": "^0.99.0",
    "@nivo/treemap": "^0.99.0",
    "@smithy/protocol-http": "5.5.1",
    "@smithy/signature-v4": "5.5.1",
    "@tanstack/react-table": "^8.21.3",
    "@uiw/react-codemirror": "^4.25.9",
    "ai": "^7.0.77",
    "chokidar": "^5.0.0",
    "docx": "^9.6.0",
    "exceljs": "^4.4.0",
    "hive-driver": "^1.0.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.0",
    "maplibre-gl": "^6.5.0",
    "microsandbox": "^0.1.1",
    "next": "16.1.6",
    "papaparse": "^5.5.3",
    "pg": "^8.20.0",
    "plotly.js-cartesian-dist": "^3.4.0",
    "plotly.js-finance-dist": "^3.4.0",
    "plotly.js-gl3d-dist": "^3.4.0",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-globe.gl": "^2.37.0",
    "react-map-gl": "^8.1.2",
    "react-plotly.js": "^2.6.0",
    "server-only": "^0.0.1",
    "snowflake-sdk": "^2.4.0",
    "three": "^0.185.1",
    "trino-client": "^0.2.9",
    "uuid": "^13.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-plotly.js": "^2.6.4",
    "@types/three": "^0.183.1",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "pyodide": "^314.0.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@10.18.1"
}
