<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the SIDECAR NODE binary only (build-desktop-sidecar.mjs
  signs it with these under the hardened runtime). V8 is a JIT: without
  allow-jit + allow-unsigned-executable-memory a hardened-runtime node
  crashes on its first executable-memory allocation — the classic
  first-notarization trap for apps that bundle Node. Nothing else gets
  these: egress-fetch and the .node addons are signed with an EMPTY
  entitlement set (no JIT, no exceptions).
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
